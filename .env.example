# TrainBench configuration — copy to .env and adjust as needed.
# All variables use the TRAINBENCH_ prefix (see backend/config.py).

# SQLite database file (created automatically on first run):
TRAINBENCH_DATABASE_URL=sqlite+aiosqlite:///./data/trainbench.db

TRAINBENCH_HOST=127.0.0.1
TRAINBENCH_PORT=8000
TRAINBENCH_DEBUG=false
TRAINBENCH_AUTH_ENABLED=false

# Optional shared-secret API key. When set, all /api requests must send it via
# the X-API-Key header or "Authorization: Bearer <key>". The frontend reads
# the same value from VITE_API_KEY at build time.
# TRAINBENCH_API_KEY=change-me-to-a-long-random-string

# Bind safety: non-loopback hosts are refused unless explicitly allowed.
# TRAINBENCH_ALLOW_PUBLIC_BIND=false

# Resource limits
# TRAINBENCH_MAX_CONCURRENT_RUNS=4
# TRAINBENCH_RATE_LIMIT_PER_MINUTE=30

# Debug/sensitive endpoints (/docs, /openapi.json, /diagnostics).
# Enabled by default for local development; disable when self-hosting.
# TRAINBENCH_EXPOSE_API_DOCS=true
# TRAINBENCH_EXPOSE_DIAGNOSTICS=true

# Required only when TRAINBENCH_AUTH_ENABLED=true:
# TRAINBENCH_JWT_SECRET_KEY=change-me-to-a-long-random-string
